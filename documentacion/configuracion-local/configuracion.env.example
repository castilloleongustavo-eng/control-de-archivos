# Archivo: documentacion/configuracion-local/configuracion.env.example
# Copia de consulta de configuracion/configuracion.env.example; conservar los mismos valores de ejemplo.
# Propósito: Sirve de plantilla para la configuración local manual.
# Funcionamiento: Se copia como configuracion.env y se completan sus valores; aplicacion/inicio.php lee cada par CLAVE=valor.

# Copiar como configuracion.env solo para configuración manual.
# Para generar una cuenta técnica y su contraseña, utilizar herramientas/configurar.ps1.
# Nombre visible en el título del navegador y el menú lateral.
NOMBRE_APLICACION=Control de archivos
# Cuenta técnica: servidor, puerto, base, usuario y contraseña local.
BD_SERVIDOR=127.0.0.1
BD_PUERTO=3306
BD_NOMBRE=documentos
BD_USUARIO=documentos_app
BD_CONTRASENA=REEMPLAZAR_POR_LA_CONTRASENA_LOCAL
# Segundos de inactividad permitidos antes de pedir un nuevo ingreso.
SESION_INACTIVIDAD=1800
# Rutas absolutas fuera del proyecto para documentos, sesiones, temporales y registros.
RUTA_DATOS=C:/AlmacenamientoPrivado/GestorArchivos
RUTA_DOCUMENTOS=C:/AlmacenamientoPrivado/GestorArchivos/documentos
